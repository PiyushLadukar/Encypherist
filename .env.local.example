# Required for the admin/event-management system (see README "Admin & MongoDB setup").
# Not required to run the public marketing site itself — Members/Projects/Gallery/
# Settings still run on the in-memory store (seed/*.json) with zero configuration.

# MongoDB connection string (e.g. a MongoDB Atlas cluster) and database name.
MONGODB_URI=
MONGODB_DB_NAME=encypherist

# Auth.js (NextAuth) session signing secret — generate with `npx auth secret`
# or `openssl rand -base64 32`. Required in production.
AUTH_SECRET=
